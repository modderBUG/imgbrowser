# 复制为 .env 后按需修改：cp .env.example .env

# 访问密码（必填）。建议 12 位以上，不要使用示例值
APP_PASSWORD=change-me-please

# 服务端口
PORT=3000

# 监听地址：本机访问可用 127.0.0.1，局域网/容器内需用 0.0.0.0
HOST=0.0.0.0

# 图片库目录（相对路径基于项目根目录）
IMAGES_DIR=./images

# 回收站目录
TRASH_DIR=./remove

# SQLite 数据库文件
DB_PATH=./imgbrowser.db

# 会话有效期（小时）
SESSION_TTL_HOURS=24

# 单页最多返回的图片数量
MAX_PAGE_SIZE=100

# 部署在 Nginx / Caddy 等反向代理之后时设为 1，
# 用于获取真实客户端 IP（登录限流）与 https 协议（Secure Cookie）
TRUST_PROXY=0

# Docker Compose 专用
APP_PORT=8211
